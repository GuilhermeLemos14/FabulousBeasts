emId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":114,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":242,"indent":0,"parameters":[1]},{"code":246,"indent":0,"parameters":[1]},{"code":121,"indent":0,"parameters":[111,111,1]},{"code":230,"indent":0,"parameters":[60]},{"code":223,"indent":0,"parameters":[[255,255,255,255],120,true]},{"code":241,"indent":0,"parameters":[{"name":"yinglong","volume":90,"pitch":100,"pan":0}]},{"code":201,"indent":0,"parameters":[0,85,8,11,8,1]},{"code":231,"indent":0,"parameters":[1,"yinglong",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,255,0,120,true]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["...It finally showed its prototype."]},{"code":401,"indent":0,"parameters":["At that moment, I felt like the sky was cracked."]},{"code":401,"indent":0,"parameters":["The heat wave burned the surroundings, turning everything into scorched earth."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["...The blood-stained sword suddenly had life,"]},{"code":401,"indent":0,"parameters":["The moment when the flames and ashes soared into the air and broke out,"]},{"code":401,"indent":0,"parameters":["Sword shadows like thousands of rainstorms fell densely."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["And the demon dragon hangs high in the sky, with its scales flashing, as bright as gold."]},{"code":401,"indent":0,"parameters":["His eyes were filled with endless indifference, as if everything in the world was nothing but dust."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Most of the divine beasts are lonely and self-reliant, for them,"]},{"code":401,"indent":0,"parameters":["The chaotic world is the prey of the weak."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But this demon dragon is different."]},{"code":401,"indent":0,"parameters":["It doesn't even require eating and breathing,"]},{"code":401,"indent":0,"parameters":["Its meaning of existence goes far beyond survival itself."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It wants to become a myth and make its figure imprinted in eternal memory."]},{"code":401,"indent":0,"parameters":["It wants to turn into a totem, carved on every battle flag that flutters in the wind."]},{"code":401,"indent":0,"parameters":["It wants to be worshipped by countless people and become a chantist that has been passed down through the ages."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["At first, this was just a fight between two people."]},{"code":401,"indent":0,"parameters":["A dispute arises from desire."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Subsequently, the battle expanded into collisions between tribes and hatred between clans."]},{"code":401,"indent":0,"parameters":["One struggle after another to survive eventually turned into a war."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Of course the demon dragon in front of him would not pay attention to these."]},{"code":401,"indent":0,"parameters":["In its eyes, life is full of disasters and fireworks are just dust in the world."]},{"code":401,"indent":0,"parameters":["...A thousand years later,"]},{"code":401,"indent":0,"parameters":["Its name will also be accompanied by those burned flags, echoing in the strong wind."]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code